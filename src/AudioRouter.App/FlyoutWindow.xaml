<Window x:Class="AudioRouter.App.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AudioRouter.App.Views"
        Title="AudioRouter" Icon="pack://application:,,,/Assets/AudioRouter.ico" Width="360" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource FlyoutTintBrush}" UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">

    <!-- Raiz animada na abertura: sobe/desliza alguns pixels a partir da borda da barra de tarefas. -->
    <Grid x:Name="Root" Margin="16,16,16,12" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Topo: dispositivo padrão + volume mestre -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Saída padrão" FontFamily="{StaticResource UiFontSmall}" FontSize="12" Opacity="0.7" />
            <ComboBox Margin="0,6,0,0" HorizontalAlignment="Stretch" MinHeight="34"
                      AutomationProperties.Name="Dispositivo de saída padrão"
                      ItemsSource="{Binding Devices}" DisplayMemberPath="Name"
                      SelectedValuePath="Id" SelectedValue="{Binding DefaultDeviceId, Mode=TwoWay}" />
            <Grid Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="38" />
                </Grid.ColumnDefinitions>
                <Button Grid.RowSpan="2" Width="36" Height="32" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Style="{StaticResource IconButtonStyle}" Click="OnMasterMuteClick"
                        ToolTip="Silenciar" AutomationProperties.Name="Silenciar saída">
                    <TextBlock Text="{Binding MasterGlyph}" FontFamily="{StaticResource IconFont}" FontSize="18" />
                </Button>
                <Slider x:Name="MasterSlider" Grid.Column="1" Minimum="0" Maximum="100" SmallChange="1" LargeChange="5"
                        IsMoveToPointEnabled="True" VerticalAlignment="Center"
                        AutomationProperties.Name="Volume principal"
                        Value="{Binding MasterVolume, Mode=TwoWay}"
                        PreviewMouseLeftButtonDown="OnMasterSliderDown"
                        PreviewMouseLeftButtonUp="OnMasterSliderUp"
                        LostMouseCapture="OnMasterSliderUp" />
                <ProgressBar Grid.Row="1" Grid.Column="1" Style="{StaticResource PeakMeterStyle}"
                             Margin="9,0,9,0" Value="{Binding MasterPeak, Mode=OneWay}" />
                <TextBlock Grid.Column="2" Text="{Binding MasterVolumeText}" HorizontalAlignment="Right"
                           VerticalAlignment="Center" FontWeight="SemiBold" />
            </Grid>
        </StackPanel>

        <Rectangle Grid.Row="1" Height="1" Margin="0,14,0,8"
                   Fill="{DynamicResource ControlStrokeColorDefaultBrush}" />

        <!-- Lista de apps -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <ItemsControl ItemsSource="{Binding Apps}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:AppRowView />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel HorizontalAlignment="Center" Margin="0,20,0,16"
                            Visibility="{Binding HasNoApps, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="&#xE767;" FontFamily="{StaticResource IconFont}" FontSize="28"
                               Opacity="0.45" HorizontalAlignment="Center" />
                    <TextBlock Text="Nenhum app com áudio no momento" FontFamily="{StaticResource UiFontSmall}"
                               Opacity="0.65" Margin="0,8,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
